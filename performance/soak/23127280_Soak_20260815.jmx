        <hashTree>
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract product name and price" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">product_name;product_price</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.name;$.price</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1;1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND;NOT_FOUND</stringProp>
          </JSONPostProcessor>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Calculate cart total" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get(&apos;product_price&apos;) != &apos;NOT_FOUND&apos;) { def total = new BigDecimal(vars.get(&apos;product_price&apos;)).multiply(new BigDecimal(vars.get(&apos;quantity&apos;))); vars.put(&apos;total_amount&apos;, total.stripTrailingZeros().toPlainString()) }</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Product detail HTTP 200" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.equals">true</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
            <stringProp name="Assertion.custom_message"></stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
          </ResponseAssertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Product correlation present" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def errors=[]; if (!vars.get(&apos;product_name&apos;) || vars.get(&apos;product_name&apos;) == &apos;NOT_FOUND&apos;) errors &lt;&lt; &apos;missing product name&apos;; try { def price=new BigDecimal(vars.get(&apos;product_price&apos;)); if (price.compareTo(BigDecimal.ZERO) &lt;= 0) errors &lt;&lt; &apos;product_price must be greater than zero&apos; } catch (Exception ignored) { errors &lt;&lt; &apos;product_price must be numeric&apos; }; if (!vars.get(&apos;total_amount&apos;)) errors &lt;&lt; &apos;missing calculated total_amount&apos;; if (errors) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(errors.join(&apos;; &apos;)) }</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="04 POST /api/cart" enabled="true">
          <stringProp name="HTTPSampler.path">/api/cart</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
