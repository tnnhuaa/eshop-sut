        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Stagger spike thread stop across ramp-down window" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">long runStart = props.get(&apos;spike.run.start.ms&apos;).toLong()
long downStart = runStart + (vars.get(&apos;baseline_seconds&apos;).toLong() + vars.get(&apos;spike_ramp_seconds&apos;).toLong() + vars.get(&apos;spike_hold_seconds&apos;).toLong()) * 1000L
int total = ctx.getThreadGroup().getNumThreads()
long slot = Math.max(1L, vars.get(&apos;spike_ramp_down_seconds&apos;).toLong() * 1000L / Math.max(1, total))
long stopAt = downStart + (ctx.getThreadNum() + 1L) * slot
if (System.currentTimeMillis() &gt;= stopAt) ctx.getThread().stop()</stringProp>
        </JSR223PreProcessor>
