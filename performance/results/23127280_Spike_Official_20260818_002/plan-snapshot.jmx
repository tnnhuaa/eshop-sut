<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="23127280 - Spike - Scenario B Coupon Purchase" enabled="true">
      <stringProp name="TestPlan.comments">Standard JMeter 5.6.3 spike plan. L is mandatory and is never inferred. Profile: 0.2L for 60s, ramp to 2L in 10s, hold 60s, ramp down over 10s, observe 0.2L for 120s. Run measured tests only in CLI after a passing 1-VU preflight and explicit student approval.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="base_url" elementType="Argument">
            <stringProp name="Argument.name">base_url</stringProp>
            <stringProp name="Argument.value">${__P(base_url,http://localhost:3000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="users_csv" elementType="Argument">
            <stringProp name="Argument.name">users_csv</stringProp>
            <stringProp name="Argument.value">${__P(users_csv,performance/data/users.csv)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="L" elementType="Argument">
            <stringProp name="Argument.name">L</stringProp>
            <stringProp name="Argument.value">${__P(L,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="baseline_factor" elementType="Argument">
            <stringProp name="Argument.name">baseline_factor</stringProp>
            <stringProp name="Argument.value">${__P(baseline_factor,0.2)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="spike_factor" elementType="Argument">
            <stringProp name="Argument.name">spike_factor</stringProp>
            <stringProp name="Argument.value">${__P(spike_factor,2.0)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="baseline_seconds" elementType="Argument">
            <stringProp name="Argument.name">baseline_seconds</stringProp>
            <stringProp name="Argument.value">${__P(baseline_seconds,60)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="spike_ramp_seconds" elementType="Argument">
            <stringProp name="Argument.name">spike_ramp_seconds</stringProp>
            <stringProp name="Argument.value">${__P(spike_ramp_seconds,10)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="spike_hold_seconds" elementType="Argument">
            <stringProp name="Argument.name">spike_hold_seconds</stringProp>
            <stringProp name="Argument.value">${__P(spike_hold_seconds,60)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="spike_ramp_down_seconds" elementType="Argument">
            <stringProp name="Argument.name">spike_ramp_down_seconds</stringProp>
            <stringProp name="Argument.value">${__P(spike_ramp_down_seconds,10)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="recovery_seconds" elementType="Argument">
            <stringProp name="Argument.name">recovery_seconds</stringProp>
            <stringProp name="Argument.value">${__P(recovery_seconds,120)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="think_min_ms" elementType="Argument">
            <stringProp name="Argument.name">think_min_ms</stringProp>
            <stringProp name="Argument.value">${__P(think_min_ms,250)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="think_max_ms" elementType="Argument">
            <stringProp name="Argument.name">think_max_ms</stringProp>
            <stringProp name="Argument.value">${__P(think_max_ms,750)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="run_id" elementType="Argument">
