            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="My orders contains new orderId" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script">try { def orders = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()); def expected = vars.get(&apos;orderId&apos;); if (!(orders instanceof List) || expected == &apos;NOT_FOUND&apos; || !orders.any { it.id?.toString() == expected }) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(&apos;New orderId &apos; + expected + &apos; was not found in my-orders&apos;) } } catch (Exception e) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(&apos;my-orders was not valid JSON: &apos; + e.message) }</stringProp>
