            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Product detail has name and numeric price" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script">def price = vars.get(&apos;product_price&apos;); if (vars.get(&apos;product_name&apos;) == &apos;NOT_FOUND&apos; || price == &apos;NOT_FOUND&apos; || !(price ==~ /[0-9]+(?:\.[0-9]+)?/)) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(&apos;Product detail did not provide a usable name and price&apos;) }</stringProp>
            </JSR223Assertion>
