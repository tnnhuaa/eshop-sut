      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Validate L, timing, base URL, CSV, and derive stress stages" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">def errors = []
def lRaw = props.getProperty(&apos;L&apos;)
def rampRaw = props.getProperty(&apos;ramp_seconds&apos;, &apos;30&apos;)
def holdRaw = props.getProperty(&apos;hold_seconds&apos;, &apos;120&apos;)
def minRaw = props.getProperty(&apos;think_min_ms&apos;, &apos;500&apos;)
def maxRaw = props.getProperty(&apos;think_max_ms&apos;, &apos;1500&apos;)
if (!lRaw || !(lRaw ==~ /[1-9][0-9]*/)) errors &lt;&lt; &apos;-JL must be a positive integer produced by calibration&apos;
if (!(rampRaw ==~ /[1-9][0-9]*/)) errors &lt;&lt; &apos;-Jramp_seconds must be a positive integer&apos;
if (!(holdRaw ==~ /[1-9][0-9]*/)) errors &lt;&lt; &apos;-Jhold_seconds must be a positive integer&apos;
if (!(minRaw ==~ /[0-9]+/) || !(maxRaw ==~ /[0-9]+/) || ((minRaw ==~ /[0-9]+/) &amp;&amp; (maxRaw ==~ /[0-9]+/) &amp;&amp; minRaw.toInteger() &gt; maxRaw.toInteger())) errors &lt;&lt; &apos;think time must satisfy 0 &lt;= min &lt;= max&apos;
def base = props.getProperty(&apos;base_url&apos;, &apos;http://localhost:3000&apos;)
try { def uri = new URI(base); if (!uri.scheme || !uri.host) errors &lt;&lt; &apos;-Jbase_url must be an absolute HTTP(S) URL&apos; } catch (Exception ignored) { errors &lt;&lt; &apos;-Jbase_url is invalid&apos; }
def csvRaw = props.getProperty(&apos;users_csv&apos;)
if (!csvRaw) { errors &lt;&lt; &apos;-Jusers_csv is mandatory&apos; } else {
  def csvFile = new File(csvRaw)
  if (!csvFile.isAbsolute()) csvFile = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), csvRaw)
  if (!csvFile.isFile()) errors &lt;&lt; &apos;users_csv does not exist: &apos; + csvFile.absolutePath
}
if (errors) {
  SampleResult.setSuccessful(false); SampleResult.setResponseCode(&apos;CONFIG&apos;); SampleResult.setResponseMessage(errors.join(&apos;; &apos;)); log.error(&apos;Stress preflight failed: &apos; + errors.join(&apos;; &apos;))
} else {
  int l = lRaw.toInteger(); int minThink = minRaw.toInteger(); int maxThink = maxRaw.toInteger()
  props.put(&apos;stress_stage1_threads&apos;, l.toString())
  props.put(&apos;stress_stage2_threads&apos;, ((l * 3 + 1).intdiv(2)).toString())
  props.put(&apos;stress_stage3_threads&apos;, (l * 2).toString())
  props.put(&apos;stress_stage4_threads&apos;, (l * 3).toString())
  props.put(&apos;stress_think_range_ms&apos;, (maxThink - minThink).toString())
  SampleResult.setSuccessful(true); SampleResult.setResponseCode(&apos;200&apos;); SampleResult.setResponseMessage(&apos;Preflight passed; L=&apos; + l); SampleResult.setIgnore()
}</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
