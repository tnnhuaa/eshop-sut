<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="23127280 - Stress - Scenario B Coupon Purchase" enabled="true">
      <stringProp name="TestPlan.comments">Stress step-load for the canonical Scenario B workflow. L is mandatory and must come from calibration; this plan does not invent a baseline. Thread groups run serially at L, ceil(1.5L), 2L, and 3L. Official runs must use non-GUI mode.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Documented CLI properties" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="base_url" elementType="Argument"><stringProp name="Argument.name">base_url</stringProp><stringProp name="Argument.value">${__P(base_url,http://localhost:3000)}</stringProp><stringProp name="Argument.metadata">=</stringProp><stringProp name="Argument.desc">SUT base URL without trailing slash</stringProp></elementProp>
          <elementProp name="users_csv" elementType="Argument"><stringProp name="Argument.name">users_csv</stringProp><stringProp name="Argument.value">${__P(users_csv,)}</stringProp><stringProp name="Argument.metadata">=</stringProp><stringProp name="Argument.desc">Global cycling pool of valid isolated credentials; rows must be at least peak 3L</stringProp></elementProp>
          <elementProp name="threads" elementType="Argument"><stringProp name="Argument.name">threads</stringProp><stringProp name="Argument.value">${__P(threads,)}</stringProp><stringProp name="Argument.metadata">=</stringProp><stringProp name="Argument.desc">Compatibility property; stress concurrency is derived from mandatory L</stringProp></elementProp>
          <elementProp name="L" elementType="Argument"><stringProp name="Argument.name">L</stringProp><stringProp name="Argument.value">${__P(L,)}</stringProp><stringProp name="Argument.metadata">=</stringProp><stringProp name="Argument.desc">Highest stable concurrency established by calibration; mandatory</stringProp></elementProp>
          <elementProp name="ramp_seconds" elementType="Argument"><stringProp name="Argument.name">ramp_seconds</stringProp><stringProp name="Argument.value">${__P(ramp_seconds,30)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="hold_seconds" elementType="Argument"><stringProp name="Argument.name">hold_seconds</stringProp><stringProp name="Argument.value">${__P(hold_seconds,120)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="think_min_ms" elementType="Argument"><stringProp name="Argument.name">think_min_ms</stringProp><stringProp name="Argument.value">${__P(think_min_ms,500)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="think_max_ms" elementType="Argument"><stringProp name="Argument.name">think_max_ms</stringProp><stringProp name="Argument.value">${__P(think_max_ms,1500)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="run_id" elementType="Argument"><stringProp name="Argument.name">run_id</stringProp><stringProp name="Argument.value">${__P(run_id,23127280_Stress_20260815)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="result_path" elementType="Argument"><stringProp name="Argument.name">result_path</stringProp><stringProp name="Argument.value">${__P(result_path,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="report_path" elementType="Argument"><stringProp name="Argument.name">report_path</stringProp><stringProp name="Argument.value">${__P(report_path,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
        </collectionProp>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="00 - Preflight (no performance samples)" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp></elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp><stringProp name="ThreadGroup.ramp_time">1</stringProp><boolProp name="ThreadGroup.scheduler">false</boolProp><stringProp name="ThreadGroup.duration"></stringProp><stringProp name="ThreadGroup.delay"></stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </SetupThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Validate L, timing, base URL, CSV, and derive stress stages" enabled="true">
          <stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp><stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">def errors = []
def lRaw = props.getProperty('L')
def rampRaw = props.getProperty('ramp_seconds', '30')
def holdRaw = props.getProperty('hold_seconds', '120')
def minRaw = props.getProperty('think_min_ms', '500')
def maxRaw = props.getProperty('think_max_ms', '1500')
if (!lRaw || !(lRaw ==~ /[1-9][0-9]*/)) errors &lt;&lt; '-JL must be a positive integer produced by calibration'
if (!(rampRaw ==~ /[1-9][0-9]*/)) errors &lt;&lt; '-Jramp_seconds must be a positive integer'
if (!(holdRaw ==~ /[1-9][0-9]*/)) errors &lt;&lt; '-Jhold_seconds must be a positive integer'
if (!(minRaw ==~ /[0-9]+/) || !(maxRaw ==~ /[0-9]+/) || ((minRaw ==~ /[0-9]+/) &amp;&amp; (maxRaw ==~ /[0-9]+/) &amp;&amp; minRaw.toInteger() &gt; maxRaw.toInteger())) errors &lt;&lt; 'think time must satisfy 0 &lt;= min &lt;= max'
def base = props.getProperty('base_url', 'http://localhost:3000')
try { def uri = new URI(base); if (!uri.scheme || !uri.host) errors &lt;&lt; '-Jbase_url must be an absolute HTTP(S) URL' } catch (Exception ignored) { errors &lt;&lt; '-Jbase_url is invalid' }
def csvRaw = props.getProperty('users_csv')
if (!csvRaw) { errors &lt;&lt; '-Jusers_csv is mandatory' } else {
  def csvFile = new File(csvRaw)
  if (!csvFile.isAbsolute()) csvFile = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), csvRaw)
  if (!csvFile.isFile()) errors &lt;&lt; 'users_csv does not exist: ' + csvFile.absolutePath
}
if (errors) {
  SampleResult.setSuccessful(false); SampleResult.setResponseCode('CONFIG'); SampleResult.setResponseMessage(errors.join('; ')); log.error('Stress preflight failed: ' + errors.join('; '))
} else {
  int l = lRaw.toInteger(); int minThink = minRaw.toInteger(); int maxThink = maxRaw.toInteger()
  props.put('stress_stage1_threads', l.toString())
  props.put('stress_stage2_threads', ((l * 3 + 1).intdiv(2)).toString())
  props.put('stress_stage3_threads', (l * 2).toString())
  props.put('stress_stage4_threads', (l * 3).toString())
  props.put('stress_think_range_ms', (maxThink - minThink).toString())
  SampleResult.setSuccessful(true); SampleResult.setResponseCode('200'); SampleResult.setResponseMessage('Preflight passed; L=' + l); SampleResult.setIgnore()
}</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>

      <TestFragmentController guiclass="TestFragmentControllerGui" testclass="TestFragmentController" testname="Scenario B - Coupon Purchase" enabled="true"/>
      <hashTree>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="Scenario B - Coupon Purchase E2E" enabled="true">
          <boolProp name="TransactionController.includeTimers">false</boolProp><boolProp name="TransactionController.parent">true</boolProp>
