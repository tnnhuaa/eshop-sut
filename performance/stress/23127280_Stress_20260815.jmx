          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Compute original cart total" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script">def price = new BigDecimal(vars.get(&apos;product_price&apos;)); def quantity = new BigDecimal(vars.get(&apos;quantity&apos;)); vars.put(&apos;cart_total&apos;, price.multiply(quantity).stripTrailingZeros().toPlainString())</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract coupon values" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">coupon_id;discount_amount;final_amount</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.coupon_id;$.discount_amount;$.final_amount</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1;1;1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND;NOT_FOUND;NOT_FOUND</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Fixed coupon applied with valid amounts" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script">def code = vars.get(&apos;coupon_code&apos;); def approvedFixedCodes = [&apos;PERF50000&apos;,&apos;BIGBUY&apos;,&apos;VIP100&apos;]; def missing = [&apos;coupon_id&apos;,&apos;discount_amount&apos;,&apos;final_amount&apos;].any { vars.get(it) == &apos;NOT_FOUND&apos; }; if (missing || !(code in approvedFixedCodes)) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(&apos;Coupon extraction failed or coupon_code is not an approved fixed coupon: &apos; + code); return }; try { def discount = new BigDecimal(vars.get(&apos;discount_amount&apos;)); def finalAmount = new BigDecimal(vars.get(&apos;final_amount&apos;)); def cartTotal = new BigDecimal(vars.get(&apos;cart_total&apos;)); if (discount &lt;= 0 || finalAmount &lt;= 0 || finalAmount &gt;= cartTotal) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(&apos;Coupon amounts must satisfy discount_amount &gt; 0 and 0 &lt; final_amount &lt; cart_total&apos;) } } catch (Exception e) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(&apos;Coupon amounts must be numeric: &apos; + e.message) }</stringProp>
            </JSR223Assertion>
            <hashTree/>
          </hashTree>
