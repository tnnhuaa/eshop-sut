              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script">if (vars.get(&apos;orderId&apos;) == &apos;NOT_FOUND&apos;) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(&apos;Checkout response did not contain orderId&apos;) }</stringProp>
