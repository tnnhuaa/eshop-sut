# Dependencies
node_modules/

# Environment files and local secrets
.env
.env.*
!.env.example
*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output and caches
dist/
build/
coverage/
.cache/
.parcel-cache/
.vite/
.expo/
.tmp/
tmp/
temp/

# Runtime databases and SQLite sidecar files
backend/database.sqlite
backend/database.sqlite-*
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal

# Postman local state and generated/private test data
.postman/
postman/**/*.local.json
postman/**/secrets*.json
postman/data/generated/
postman/reports/tmp/
postman/reports/ci/
postman/reports/ci-demo/
# Raw Newman JSON contains runtime tokens; keep only sanitized HTML and summary artifacts.
postman/reports/final-newman.json

# Office temporary files
~$*.docx
~$*.xlsx
~$*.pptx

# Editor and operating-system files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
